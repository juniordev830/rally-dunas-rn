extends SceneTree
const Rules = preload("res://scripts/driving_rules.gd")

func _initialize() -> void:
	assert(Rules.next_speed(0.0, 1.0, 1.0) == 16.0)
	assert(Rules.next_speed(28.0, 1.0, 1.0) == 29.0)
	assert(Rules.next_speed(0.0, -1.0, 1.0) == -10.0)
	assert(Rules.next_speed(10.0, 0.0, 0.5) == 5.5)
	assert(Rules.next_speed(10.0, 1.0, -1.0) == 0.0)
	assert(Rules.reached_checkpoint(6.0))
	assert(not Rules.reached_checkpoint(6.1))
	assert(Rules.speed_kmh(10.0) == 36)
	assert(Rules.medal_for_time(40.0) == "OURO")
	assert(Rules.medal_for_time(55.0) == "OURO")
	assert(Rules.medal_for_time(55.1) == "PRATA")
	assert(Rules.medal_for_time(90.0) == "PRATA")
	assert(Rules.medal_for_time(90.1) == "BRONZE")
	assert(Rules.medal_for_time(-1.0) == "INVALIDO")
	assert(Rules.medal_for_time(INF) == "INVALIDO")
	assert(is_equal_approx(Rules.split_seconds(15.0, 18.5), 3.5))
	assert(is_equal_approx(Rules.split_seconds(2.0, 2.0), 0.0))
	assert(is_equal_approx(Rules.split_seconds(6.0, 5.0), -1.0))
	assert(is_equal_approx(Rules.split_seconds(-1.0, 2.0), -1.0))
	print("Driving rules: 19 assertions passed")
	quit()
